# Supabase (Angular browser via public/env.js + Node API via supabase-js)
# SUPABASE_URL + SUPABASE_PUBLIC_KEY are safe for the SPA.
# SERVICE_ROLE_KEY is server-only — never ship to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (direct Postgres connection string, if used outside Supabase client)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Email provider (transactional notifications)
EMAIL_API_KEY=your-email-api-key

# Google Gemini (Trip Advisor "Buddy" — server only)
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Server (optional)
NODE_ENV=development
PORT=3000
# ALLOW_MOCK_DATA=true

# See docs/api/auth-login-signup.md and docs/api/nodejs-db-integration.md
