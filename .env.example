# Supabase (Node API auth + Postgres via supabase-js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (direct Postgres connection string, if used outside Supabase client)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Email provider (transactional notifications)
EMAIL_API_KEY=your-email-api-key

# Server (optional)
NODE_ENV=development
PORT=3000
# ALLOW_MOCK_DATA=true

# See docs/api/nodejs-db-integration.md
